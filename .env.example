# Copy to .env and fill the Supabase values for the API server.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_secret_key

# Optional: only needed by external integrations that use the shared API token.
API_ACCESS_TOKEN=
API_DOCS_ENABLED=false
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
