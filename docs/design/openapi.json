{
  "openapi": "3.1.0",
  "info": {
    "title": "Keyword Risk Analyzer API",
    "version": "1.0.0",
    "description": "현재 구현 기준 문서용 명세. 응답 스키마는 반환 코드에 근거해 보충했으며 서버 response_model 검증은 구현하지 않았습니다."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
