# csv is for local development; use supabase for shared operation and the API.
STORAGE_BACKEND=csv
SUPABASE_URL=https://qmhdwfqcihpfjfvcjcwa.supabase.co
# Server-only sb_secret_... or legacy service_role key. Never commit the real key.
SUPABASE_SECRET_KEY=
# Optional separate integration token; generate with secrets.token_urlsafe(32).
# Supabase user access tokens also work without this integration token.
API_ACCESS_TOKEN=
API_DOCS_ENABLED=false
# Local CSV mode administrator only (Supabase uses app_metadata.role=admin).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional administrator email alerts for keyword inquiries (Resend).
# The sender address/domain must be verified with Resend before enabling alerts.
RESEND_API_KEY=
KEYWORD_REQUEST_ADMIN_EMAIL=
KEYWORD_REQUEST_FROM_EMAIL=
